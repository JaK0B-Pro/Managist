{
  
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "managist",
  "version": "0.1.3",
  "identifier": "com.managist.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "loading",
        "title": "Managist - Loading",
        "url": "loading.html",
        "width": 600,
        "height": 500,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": true
      },
      {
        "label": "main",
        "title": "Managist",
        "url": "index.html",
        "width": 500,
        "height": 600,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "en-US"
      },      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "window": {
      "all": true,
      "center": true
    },
      "updater": {
      "active": true,
      "endpoints": [
        "https://api.github.com/repos/JaK0B-Pro/managist/releases/latest"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFRUVFNDcxOTFENjlBMTIKUldRU210YVJjZ1R1TGxUdG9SaitUYnJxQURMTlFZUll6cEtoWVNqZ0gvOVNSdmNZZ045N2QySkwK"
    }
  }
}